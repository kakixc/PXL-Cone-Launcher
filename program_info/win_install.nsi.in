!include "FileFunc.nsh"
!include "LogicLib.nsh"
!include "MUI2.nsh"

!include "x64.nsh"

AllowSkipFiles off
Unicode true

Name "@Launcher_DisplayName@"
InstallDir "$LOCALAPPDATA\Programs\@Launcher_InstallID@"
InstallDirRegKey HKCU "Software\@Launcher_InstallID@" "InstallDir"
RequestExecutionLevel user
OutFile "../PXL-Cone-Setup.exe"

!define MUI_ICON "../@Launcher_Branding_ICO@"

!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\@Launcher_InstallID@"

