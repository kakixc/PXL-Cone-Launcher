#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>

IDI_ICON1               ICON    DISCARDABLE     "pxlcone.ico"
1 RT_MANIFEST "pxlcone.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PXL_WINDOWS_VERSION_COMMA@
PRODUCTVERSION  @PXL_WINDOWS_VERSION_COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
        BLOCK "StringFileInfo"
        BEGIN
                BLOCK "000004b0"
                BEGIN
                        VALUE "CompanyName", "@Launcher_Authors@"
                        VALUE "FileDescription", "@Launcher_DisplayName@"
                        VALUE "FileVersion", "@PXL_WINDOWS_VERSION_DISPLAY@"
                        VALUE "ProductName", "@Launcher_DisplayName@"
                        VALUE "ProductVersion", "@PXL_WINDOWS_VERSION_DISPLAY@"
                END
        END
        BLOCK "VarFileInfo"
        BEGIN
                VALUE "Translation", 0x0000, 0x04b0 // Unicode
        END
END
